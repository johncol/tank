# Your tank credentials and sites, shared by every project. Copy this file
# to ~/.config/tank/.env and fill in your own values:
#   mkdir -p ~/.config/tank && cp .env.example ~/.config/tank/.env
# Never commit it. Variables already set in the environment win over it.
# Project settings (e.g. CONFLUENCE_SPACE_ID) go in the project's tank.env.

# Atlassian site base URL, no trailing slash.
CONFLUENCE_BASE_URL=https://your-org.atlassian.net/wiki

# Atlassian account email used to sign in to Confluence.
CONFLUENCE_EMAIL=

# API token for CONFLUENCE_EMAIL, created at
# https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_API_TOKEN=

# Datadog API key (identifies the org), created at
# https://app.datadoghq.com/organization-settings/api-keys (or your site's
# equivalent URL, see DATADOG_SITE below).
DATADOG_API_KEY=

# Datadog application key (identifies the caller and its permissions),
# scoped to dashboards_read, dashboards_write, logs_read_config,
# logs_generate_metrics, monitors_read, monitors_write, synthetics_read, and
# synthetics_write, created at
# https://app.datadoghq.com/organization-settings/application-keys
DATADOG_APP_KEY=

# Datadog site hostname, no scheme or trailing slash, e.g. "datadoghq.com"
# for the default US1 site, or "us5.datadoghq.com" for US5. See
# https://docs.datadoghq.com/getting_started/site/ for the full list.
DATADOG_SITE=
