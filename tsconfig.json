{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "bin/**/*.js",
    "shared/**/*.js",
    "confluence/**/*.js",
    "datadog/**/*.js",
    "project/**/*.js"
  ],
  "exclude": ["node_modules", "**/__tests__/**"]
}
